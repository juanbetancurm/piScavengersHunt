{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "chmod +x ./mvnw && ./mvnw clean package spring-boot:repackage -DskipTests"
  },
  "deploy": {
    "startCommand": "java -jar target/pi-puzzle-game-0.0.1-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}